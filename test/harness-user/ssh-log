#!/bin/sh
# Installed ahead of /usr/bin/ssh on every user's PATH in the
# harness-user container check: logs who runs ssh, from which processes,
# with which arguments, to /var/log/ssh-calls.log, then runs ssh.
chain=""
pid=$PPID
for _ in 1 2 3; do
	[ -n "$pid" ] && [ "$pid" -gt 1 ] || break
	chain="$chain<$(ps -o args= -p "$pid")"
	pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
done
echo "user=$(id -un) parents=$chain args=$*" >>/var/log/ssh-calls.log
exec /usr/bin/ssh "$@"
